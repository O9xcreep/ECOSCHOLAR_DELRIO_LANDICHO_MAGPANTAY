# Environment / secrets
.env

# Virtual environment
venv/
__pycache__/
*.pyc

# Local scratch space for temporary OCR files only - real uploads live in
# MongoDB GridFS now, nothing permanent is ever written here.
uploads/

# Database backups (scripts/backup_database.py) - real applicant/account data,
# never committed.
backups/

# Old, retired models - superseded by the ecoscholar_* model files
model.pkl
model_combined.pkl

# The ecoscholar_classifier.joblib / ecoscholar_regressor.joblib / ecoscholar_scaler.joblib
# / ecoscholar_feature_contract.json / ecoscholar_encoding_maps.json / ecoscholar_predict.py
# files are intentionally NOT ignored - the deployed backend needs them in the repo to
# load the eligibility model (see schema/ml_model.md).
