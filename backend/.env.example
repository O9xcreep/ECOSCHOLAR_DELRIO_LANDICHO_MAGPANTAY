# MongoDB Atlas connection string (Database Access user, not your Atlas login)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=ecoscholars

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Secret key used to sign auth tokens - set a long random value in production
SECRET_KEY=

# Set to "false" in production
FLASK_DEBUG=true

# Optional: override the Tesseract binary path on non-Windows hosts
TESSERACT_CMD=

# Used to build password-reset links in emails
FRONTEND_URL=http://localhost:5173

# SMTP config for sending password-reset and admin-account emails. Works with
# Gmail (an App Password - see myaccount.google.com/apppasswords) or a
# transactional provider's SMTP relay (e.g. Resend: smtp.resend.com, user
# "resend", password is your API key). Leave blank in dev to skip sending;
# the API still responds normally, it just won't deliver a real email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The visible "From" address - defaults to SMTP_USER if left blank. Only need
# to set this separately when the provider's auth login isn't a real mailbox
# (e.g. Resend's login is literally "resend", not an email address).
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EcoScholar
