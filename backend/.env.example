# MongoDB Atlas connection string (Database Access user, not your Atlas login)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=ecoscholars

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://escholar.site

# Secret key used to sign auth tokens - set a long random value in production
SECRET_KEY=

# Set to "false" in production
FLASK_DEBUG=true

# Optional: override the Tesseract binary path on non-Windows hosts
TESSERACT_CMD=

# Used to build password-reset links in emails
FRONTEND_URL=https://escholar.site

# Which HTTP email API to send password-reset and admin-account emails
# through - "resend" (default) or "mailjet". Both are sent over HTTPS rather
# than raw SMTP so delivery isn't blocked by hosts (e.g. Render's free tier)
# that block outbound SMTP ports. Switch this to "mailjet" if Resend's free-
# tier sending limit is hit - no code change needed, just flip it back once
# the limit resets.
EMAIL_PROVIDER=resend

# Resend API key (https://resend.com/api-keys). Leave blank in dev to skip
# sending; the API still responds normally, it just won't deliver a real email.
RESEND_API_KEY=

# Mailjet API key + secret key (https://app.mailjet.com/account/apikeys) -
# only used when EMAIL_PROVIDER=mailjet.
MAILJET_API_KEY=
MAILJET_API_SECRET=

# The visible "From" address - must be on a domain verified with whichever
# provider is active (Resend or Mailjet).
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EcoScholar
