# MongoDB Atlas connection string (Database Access user, not your Atlas login)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=ecoscholars

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://escholar.site

# Secret key used to sign auth tokens - set a long random value in production
SECRET_KEY=

# Set to "false" in production
FLASK_DEBUG=true

# Optional: override the Tesseract binary path on non-Windows hosts
TESSERACT_CMD=

# Used to build password-reset links in emails
FRONTEND_URL=https://escholar.site

# Resend API key used to send password-reset and admin-account emails via
# Resend's HTTP API (https://resend.com/api-keys). Sent over HTTPS rather than
# raw SMTP so it isn't blocked by hosts (e.g. Render's free tier) that block
# outbound SMTP ports. Leave blank in dev to skip sending; the API still
# responds normally, it just won't deliver a real email.
RESEND_API_KEY=
# The visible "From" address - must be on a domain verified with Resend.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EcoScholar
